{
  "name": "lozenge-react",
  "version": "0.1.0",
  "description": "React bindings for Lozenge \u2014 a Jira-flavoured design system with runtime theme axes: continuous contrast dial, parametric accent, glass materials.",
  "type": "module",
  "license": "MIT",
  "repository": "github:jethac/lozenge-react",
  "main": "./dist/lozenge-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lozenge-react.js"
    },
    "./lozenge.css": "./dist/lozenge.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "vite build && node scripts/copy-css.mjs",
    "build:demo": "vite build --config vite.demo.config.ts",
    "test": "vitest run",
    "lint": "node scripts/lozenge-lint.mjs",
    "prepare": "vite build && node scripts/copy-css.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "parse5": "^8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.0.0"
  }
}
